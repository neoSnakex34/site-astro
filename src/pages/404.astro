---
import "../styles/global.css";

// English-only site: the /it locale was retired (see old_locale_deprecated/).
// The Italian copy is preserved here, commented out, for a future review.
const translations = {
  en: {
    title: "404",
    subtitle: "Page Not Found",
    text: "I'm sorry pal, you're page is in another castle.",
    btn: "go back home",
    link: "/"
  },
  // it: {
  //   title: "404",
  //   subtitle: "Pagina Non Trovata",
  //   text: "Mi dispiace, questa pagina non esiste.",
  //   btn: "Torna alla home",
  //   link: "/it"
  // }
};

const t = translations.en;
---

<!DOCTYPE html>
<html lang="en" class="bg-base-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title id="doc-title">404 - Page Not Found</title>
    <meta name="robots" content="noindex" />
  </head>

  <body class="min-h-screen grid place-items-center p-4">

    <div class="text-center max-w-md space-y-6">

      <h1 id="err-title" class="text-6xl font-black">
        {t.title}
      </h1>

      <h2 id="err-subtitle" class="text-3xl font-bold">
        {t.subtitle}
      </h2>

      <p id="err-text" class="text-lg opacity-80">
        {t.text}
      </p>

      <div class="pt-4">
        <a id="err-btn " href={t.link} class="btn btn-error primary btn-lg font-bold">
          {t.btn}
        </a>
      </div>

    </div>



  </body>
</html>

<!--
  Preserved for a future review: the old client-side Italian swap for /it URLs.
  Legacy /it/* URLs now redirect to their English counterpart (astro.config.mjs),
  so this branch is dead code.

  <script define:vars={{ translations }}>
    if (window.location.pathname.startsWith("/it")) {
      const t = translations.it;

      document.documentElement.lang = "it";
      document.title = `${t.title} - ${t.subtitle}`;

      document.getElementById("err-subtitle").innerText = t.subtitle;
      document.getElementById("err-text").innerText = t.text;

      const btn = document.getElementById("err-btn");
      btn.innerText = t.btn;
      btn.href = t.link;
    }
  </script>
-->
