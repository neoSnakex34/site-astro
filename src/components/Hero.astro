---
import Particles from "./Particles.astro";



interface Props {
  title: string;
  subtitle: string;
  subparagraph?: string;
  buttonText?: string;
  showButton?: boolean;
  particleOpacity?: number;


}
const {
  title,
  subtitle,
  subparagraph = "",
  buttonText = "",
  showButton = false,
  particleOpacity = 0.4,
} = Astro.props;

---
<div class="hero relative isolate overflow-hidden w-full bg-base-200 min-h-[calc(100dvh-4rem)] lg:min-h-[calc(100dvh-5.5rem)]">
  <Particles opacity={particleOpacity} />

  <div class="hero-content hero-particle-exclusion relative z-10 text-center">
    <div class="max-w-md">
      <h1>
        <span class="block text-2xl md:text-2xl font-medium">{title}</span>{" "}
        <span class="block text-5xl md:text-7xl font-bold mt-2">{subtitle}</span>
      </h1>
      {subparagraph && (
        <h3 class="text-lg md:text-xl font-normal pt-10 py-6">
          {subparagraph}
        </h3>
      )}

      {showButton && <button id="hero-button" class="btn btn-lg btn-success font-bold">{buttonText}</button>}
    </div>
  </div>
</div>


<script>
  const button = document.getElementById("hero-button");
  if (button) {
    button.addEventListener("click", () => {
      window.location.href = "/about";
    });
  }
</script>
