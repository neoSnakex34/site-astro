---
import Particles from "@tsparticles/astro";
import type { ISourceOptions } from "@tsparticles/engine";

interface Props {
  id?: string;
  class?: string;
  opacity?: number;
}

const { id = "tsparticles", class: className = "", opacity = 0.5 } = Astro.props;

const options: ISourceOptions = {
  fullScreen: { enable: false },
  background: { color: "transparent" },

  particles: {
    number: { value: 130, density: { enable: true, width: 900, height: 900 } },
    color: { value: ["#a5d8ff", "#99f6e4"] },
    opacity: { value: opacity },
    size: { value: { min: 1, max: 3 } },
    links: { enable: true, color: "#a5d8ff", distance: 165, opacity: 0.2 * opacity, width: 1 },
    move: {
      enable: true,
      speed: 0.4,
      direction: "none",
      random: true,
      straight: false,
      outModes: "out",
    },
  },

  interactivity: {
    detectsOn: "window",
    events: { onHover: { enable: true, mode: "grab" } },
    modes: { grab: { distance: 200, links: { opacity: 0.1 } } },
  },

  responsive: [
    {
      maxWidth: 768,
      options: {
        particles: {
          number: { value: 40 },
          links: { distance: 120 },
          move: { speed: 0.2 },
        },
        interactivity: { events: { onHover: { enable: false } } },
      },
    },
  ],
};
---

<!-- The engine looks up this ID; without it, it appends a canvas to body. -->
<div
  id={id}
  class={`particles-background ${className}`}

  aria-hidden="true"
>
  <Particles id={id} options={options} />
</div>

<style is:global>
  .particles-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .particles-background astro-particles,
  .particles-background canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { initParticlesEngine } from "@tsparticles/astro";
  import { loadSlim } from "@tsparticles/slim";

  await initParticlesEngine(async (engine) => {
    await loadSlim(engine);
  });
</script>
