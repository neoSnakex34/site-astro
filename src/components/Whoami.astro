---
// English-only site: the /it locale was retired (see old_locale_deprecated/).
// Italian branch kept for a future review, hence the comment block.
// const { pathname } = Astro.url;
// const isItalian = pathname.startsWith("/it");
//
// const ariaLabel = isItalian
//   ? "Terminale: esecuzione del comando whoami che mostra il mio nome"
//   : "Terminal: running whoami command displaying my name";

const ariaLabel = "Terminal: running whoami command displaying my name";
---

<div
  role="figure" 
  aria-label={ariaLabel}
  class="mockup-code text-left text-lg lg:pb-70 md:pb-65 pb-50 lg:mb-20 md:mb-8 mb-6"
>
    <div>
      <pre class="font-jetbrains-mono font-bold"><span>$ </span><span class="typewriter">whoami</span><span class="cmd-cursor" aria-hidden="true">█</span></pre>
      
      <pre class="font-jetbrains-mono font-bold text-success output-line">Francesco James Fanti</pre>
      
      <pre class="font-jetbrains-mono font-bold prompt-line"><span>$ </span><span class="animate-blink" aria-hidden="true">█</span></pre>
    </div>
</div>

<style>
  /* Pure CSS sequence, no JS. Font is monospace so 6ch = "whoami".
     Timeline:
       0.2s  typing starts (0.4s)
       0.6s  command-line cursor appears, blinks 2x (on+off) at 2s rate
       4.4s  during the 2nd off, just before it ends = "enter pressed":
             name appears instantly, command cursor is gone,
             fresh prompt line appears */
  .typewriter {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    width: 0;
    animation: typing 0.4s steps(6) 0.2s forwards;
  }

  @keyframes typing {
    to { width: 6ch; }
  }

  /* 2 complete blinks (on+off each), 1s on / 1s off to match the prompt
     cursor rate. step-end holds each keyframe until the next, so:
     on 0.6-1.6s, off 1.6-2.6s, on 2.6-3.6s, off 3.6-4.6s.
     At 4.6s the 2nd blink ends = "enter pressed". */
  .cmd-cursor {
    opacity: 0;
    animation: cmd-cursor-life 4s step-end 0.6s 1 forwards;
  }

  @keyframes cmd-cursor-life {
    0%   { opacity: 1; }
    25%  { opacity: 0; }
    50%  { opacity: 1; }
    75%  { opacity: 0; }
    100% { opacity: 0; }
  }

  /* 0s duration = appears instantly, 200ms before the 2nd blink's off
     phase ends, so the name shows while the cursor is already off. */
  .output-line {
    opacity: 0;
    animation: output-in 0s linear 4.4s forwards;
  }

  .prompt-line {
    opacity: 0;
    animation: output-in 0s linear 4.4s forwards;
  }

  @keyframes output-in {
    to { opacity: 1; }
  }

  /* Reduced motion: show everything immediately, no animation. */
  @media (prefers-reduced-motion: reduce) {
    .typewriter { animation: none; width: 6ch; }
    .cmd-cursor { animation: none; opacity: 0; }
    .output-line, .prompt-line { animation: none; opacity: 1; }
  }
</style>