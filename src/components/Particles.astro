---
import type { ISourceOptions } from "@tsparticles/engine";

interface Props {
  id?: string;
  class?: string;
  opacity?: number;
}

const { id = "tsparticles", class: className = "", opacity = 0.5 } = Astro.props;

const options: ISourceOptions = {
  fullScreen: { enable: false },
  background: { color: "transparent" },

  particles: {
    number: { value: 120, density: { enable: false } },
    color: { value: ["#a5d8ff", "#99f6e4"] },
    opacity: { value: opacity },
    size: { value: { min: 1, max: 3 } },
    links: { enable: true, color: "#a5d8ff", distance: 165, opacity: 0.2 * opacity, width: 1 },
    move: {
      enable: true,
      speed: 0.4,
      direction: "none",
      random: true,
      straight: false,
      outModes: "out",
    },
  },

  interactivity: {
    detectsOn: "window",
    events: {
      onHover: { enable: true, mode: "grab" },
      onDiv: {
        enable: true,
        selectors: ".hero-particle-exclusion",
        mode: "repulse",
        type: "circle",
      },
    },
    modes: {
      grab: { distance: 200, links: { opacity: 0.1 } },
      repulse: { speed: 0.2, factor: 10, maxSpeed: 2 },
    },
  },

  responsive: [
    {
      maxWidth: 768,
      mode: "canvas",
      options: {
        particles: {
          number: { value: 60 },
          links: { distance: 120 },
          move: { speed: 0.2 },
        },
      },
    },
  ],
};

// Serialized once on the server; the client script below reads it back.
const serializedOptions = JSON.stringify(options);
---

<!--
  The engine looks up this ID on the client and paints into it. The canvas is
  created by tsParticles itself, so this element must stay empty.
-->
<div
  id={id}
  class={`particles-background ${className}`}
  data-particles-options={serializedOptions}
  aria-hidden="true"
></div>

<style is:global>
  .particles-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .particles-background canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    animation: particles-fade-in 800ms ease-out both;
  }

  @keyframes particles-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Belt and braces: never show the canvas when the OS asks for reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .particles-background {
      display: none;
    }
  }
</style>

<script>
  import { tsParticles } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";
  import { loadResponsivePlugin } from "@tsparticles/plugin-responsive";
  import type { Container } from "@tsparticles/engine";

  const STORAGE_KEY = "particles-enabled";

  // Loaded once per page: register the slim bundle, then initialise the engine.
  // Everything stays in this one module, so there is no init/upgrade race.
  const engineReady = (async () => {
    await loadSlim(tsParticles);
    await loadResponsivePlugin(tsParticles);

    if (typeof tsParticles.init === "function") {
      await tsParticles.init();
    }
  })();

  const containers = (): HTMLElement[] =>
    Array.from(document.querySelectorAll<HTMLElement>("[data-particles-options]"));

  const mount = async (element: HTMLElement) => {
    const serialized = element.dataset.particlesOptions;
    const id = element.id;

    if (!serialized || !id || element.dataset.mounted === "1") return;

    element.dataset.mounted = "1";

    await engineReady;

    // Wait for layout so the canvas gets the real hero size, not 0x0.
    await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));

    try {
      await tsParticles.load({ id, options: JSON.parse(serialized) });
    } catch (error) {
      console.error("[particles] failed to mount", error);
    }
  };

  const syncToggleButton = (enabled: boolean) => {
    const button = document.getElementById("particles-toggle");

    if (!button) return;

    button.setAttribute("aria-pressed", String(enabled));
    button.textContent = enabled ? "Disable particles" : "Enable particles";
  };

  const setEnabled = async (next: boolean) => {
    enabled = next;

    try {
      localStorage.setItem(STORAGE_KEY, next ? "on" : "off");
    } catch {
      // storage unavailable (private mode) — session-only toggle
    }

    for (const element of containers()) {
      if (next) {
        element.style.display = "";
        element.dataset.mounted = "";
        await mount(element);
      } else {
        element.style.display = "none";
      }
    }

    if (!next) {
      tsParticles.items.forEach((container: Container) => container.destroy());
    }

    syncToggleButton(next);
  };

  // Accessibility: honour the OS-level reduced-motion preference unless the
  // visitor made an explicit choice with the footer toggle.
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  let stored: string | null = null;

  try {
    stored = localStorage.getItem(STORAGE_KEY);
  } catch {
    stored = null;
  }

  let enabled = stored === "on" || (stored === null && !reducedMotion.matches);

  const boot = () => void setEnabled(enabled);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }

  // Live-follow the OS preference when no explicit choice was stored.
  reducedMotion.addEventListener("change", (event) => {
    let current: string | null = null;

    try {
      current = localStorage.getItem(STORAGE_KEY);
    } catch {
      current = null;
    }

    if (current === null) {
      void setEnabled(!event.matches);
    }
  });

  document
    .getElementById("particles-toggle")
    ?.addEventListener("click", () => void setEnabled(!enabled));
</script>
