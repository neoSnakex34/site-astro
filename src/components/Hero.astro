---
import Particles from "./Particles.astro";



interface Props {
  title: string;
  subtitle: string;
  subparagraph?: string;
  buttonText?: string;
  showButton?: boolean;
  particleOpacity?: number;


}
const {
  title,
  subtitle,
  subparagraph = "",
  buttonText = "",
  showButton = false,
  particleOpacity = 0.4,
} = Astro.props;

---
<div class="hero relative isolate overflow-hidden w-full bg-base-200 min-h-[calc(100svh-4rem)]">
  <Particles opacity={particleOpacity} />
  <div class="hero-flare" aria-hidden="true"></div>

  <div class="hero-content hero-particle-exclusion relative z-10 text-center">
    <div class="max-w-md">
      <h1>
        <span class="block text-2xl md:text-2xl font-medium">{title}</span>{" "}
        <span class="block text-5xl md:text-7xl font-bold mt-2">{subtitle}</span>
      </h1>
      {subparagraph && (
        <h3 class="text-lg md:text-xl font-normal pt-10 py-6">
          {subparagraph}
        </h3>
      )}

      {showButton && <button id="hero-button" class="btn btn-lg btn-success font-bold">{buttonText}</button>}
    </div>
  </div>
</div>

<style>
  /* Soft flare anchored to the bottom-right corner of the hero: a radial
     glow slightly brighter than the particle blue (#a5d8ff), fading to
     transparent well before mid-screen. Painted above the particle canvas
     and below the hero content (z-10), pointer-transparent, static (present
     at first paint, no animation). */
  .hero-flare {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      circle 60vmax at 100% 100%,
      rgba(201, 231, 255, 0.20),
      rgba(165, 216, 255, 0.10) 40%,
      transparent 70%
    );
  }
</style>


<script>
  const button = document.getElementById("hero-button");
  if (button) {
    button.addEventListener("click", () => {
      window.location.href = "/about";
    });
  }
</script>
